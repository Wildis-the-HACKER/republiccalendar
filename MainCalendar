<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Rook Republic Calendar</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 10px;
        background: #0785b0;
        color: white;
        font-family: Arial, sans-serif;
    }

    .calendar {
        max-width: 700px;
        margin: auto;
    }

    .calendar-header {
        border: 2px solid #35e68a;
        border-radius: 10px;
        padding: 10px;
        text-align: center;
        margin-bottom: 10px;
    }

    .calendar-title {
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .calendar-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    button {
        background: #0785b0;
        color: white;
        border: 1px solid #35e68a;
        border-radius: 6px;
        padding: 6px 12px;
        cursor: pointer;
        font-size: 15px;
    }

    button:hover {
        background: #08779b;
    }

    .month-name {
        font-size: 18px;
        font-weight: bold;
    }

    .weekdays,
    .days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 3px;
    }

    .weekday {
        text-align: center;
        font-weight: bold;
        padding: 6px 2px;
        font-size: 13px;
    }

    .day {
        min-height: 65px;
        border: 1px solid #35d9e6;
        border-radius: 6px;
        padding: 5px;
        cursor: pointer;
        background: #0785b0;
        transition: background 0.15s;
    }

    .day:hover {
        background: #087b9f;
    }

    .day.empty {
        border: none;
        cursor: default;
        background: transparent;
    }

    .day-number {
        font-weight: bold;
        font-size: 14px;
    }

    .today {
        border: 2px solid #35e68a;
    }

    .event-dot {
        display: block;
        font-size: 11px;
        margin-top: 5px;
        line-height: 1.2;
    }

    .event-panel {
        display: none;
        border: 2px solid #35d9e6;
        border-radius: 8px;
        padding: 10px;
        margin-top: 10px;
        background: #0785b0;
    }

    .event-panel.active {
        display: block;
    }

    .event-date {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .event {
        border-left: 3px solid #35e68a;
        padding: 5px 8px;
        margin: 6px 0;
    }

    .event-title {
        font-weight: bold;
    }

    .event-time {
        color: #b9e6e6;
        font-size: 14px;
        margin-top: 2px;
    }

    .no-events {
        color: #c8e3e8;
    }
    /* ========================================
   RESPONSIVE CALENDAR
   ======================================== */

@media (max-width: 500px) {

    body {
        padding: 6px;
    }

    .calendar-title {
        font-size: 18px;
    }

    .calendar-controls {
        gap: 4px;
    }

    button {
        padding: 5px 7px;
        font-size: 13px;
    }

    .month-name {
        font-size: 16px;
    }

    .day {
        min-height: 52px;
        padding: 4px;
    }

    .weekday {
        font-size: 11px;
        padding: 5px 1px;
    }

    .day-number {
        font-size: 13px;
    }

    .event-dot {
        font-size: 10px;
    }

}


@media (max-width: 380px) {

    .calendar-title {
        font-size: 16px;
    }

    .calendar-controls {
        gap: 2px;
    }

    button {
        padding: 4px 5px;
        font-size: 12px;
    }

    .month-name {
        font-size: 14px;
    }

    .day {
        min-height: 45px;
        padding: 3px;
    }

    .weekday {
        font-size: 10px;
    }

    .day-number {
        font-size: 12px;
    }

    /*
       On very narrow screens, only show
       the first part of an event indicator.
       The full event is still available
       when the date is clicked.
    */

    .event-dot {
        font-size: 0;
    }

    .event-dot::before {
        content: "•";
        font-size: 15px;
    }

}
</style>
</head>

<body>

<div class="calendar">

    <div class="calendar-header">

        <div class="calendar-title">
            ♜ THE ROOK REPUBLIC CALENDAR ♜
        </div>

        <div class="calendar-controls">
            <button onclick="changeMonth(-1)">‹ Previous</button>

            <div id="monthName" class="month-name"></div>

            <button onclick="changeMonth(1)">Next ›</button>
        </div>

    </div>

    <div class="weekdays">
        <div class="weekday">Sun</div>
        <div class="weekday">Mon</div>
        <div class="weekday">Tue</div>
        <div class="weekday">Wed</div>
        <div class="weekday">Thu</div>
        <div class="weekday">Fri</div>
        <div class="weekday">Sat</div>
    </div>

    <div id="days" class="days"></div>

    <div id="eventPanel" class="event-panel"></div>

</div>


<script>

let currentDate = new Date();


/*
    ========================================
    REPUBLIC EVENT DATABASE
    ========================================

    All events are stored by exact date.

    Format:

    "YYYY-MM-DD": [
        {
            title: "Event name",
            time: "Event time",
            link: "Event URL"
        }
    ]

    Multiple events can exist on the
    same date.
*/


const eventDatabase = {};


/*
    ========================================
    EVENT INFORMATION
    ========================================
*/

const eventPatterns = {

    puzzleFriday: {
        title: "🧩 Puzzle Friday",
        time: "All day",
        link: "https://example.com"
    },

    openingAcademy: {
        title: "📖 Opening Academy Saturday",
        time: "All day",
        link: ""
    },

    saturdayKnightSwiss: {
        title: "♟ Saturday Knight Swiss",
        time: "7:00 PM CST",
        link: ""
    },

    tacticsEndgameSunday: {
        title: "⚔️ Tactics and Endgame Sunday",
        time: "All day",
        link: ""
    }

};
/*
    ========================================
    DATABASE DIRECTORY
    ========================================

    Each date can override the automatically
    generated event information.

    You only need to put something here when
    a date needs to be different.

*/

const databaseDirectory = {

    
    "2026-09-18": {
        puzzleFriday: {
            link: "https://microsoft.com/"
        }
    }

    

};

/*
    ========================================
    ADD EVENT
    ========================================
*/

function addEvent(date, event) {

    if (!eventDatabase[date]) {
        eventDatabase[date] = [];
    }

    eventDatabase[date].push({
        title: event.title,
        time: event.time,
        link: event.link
    });

}


/*
    ========================================
    GENERATE CURRENT SCHEDULE
    ========================================

    September 1, 2026
    through
    December 31, 2026

*/

function generateRepublicSchedule() {

    const start =
        new Date(2026, 8, 1);

    const end =
        new Date(2026, 11, 31);


    for (
        let date = new Date(start);
        date <= end;
        date.setDate(date.getDate() + 1)
    ) {

        const dayOfWeek =
            date.getDay();

        const dateKey =
            getDateKey(
                date.getFullYear(),
                date.getMonth() + 1,
                date.getDate()
            );


        /*
            Make sure this date exists
            in the database.
        */

        eventDatabase[dateKey] = [];


        /*
            Friday
        */

        if (dayOfWeek === 5) {

            addDatabaseEvent(
                dateKey,
                "puzzleFriday"
            );

        }


        /*
            Saturday
        */

        if (dayOfWeek === 6) {

            addDatabaseEvent(
                dateKey,
                "openingAcademy"
            );

            addDatabaseEvent(
                dateKey,
                "saturdayKnightSwiss"
            );

        }


        /*
            Sunday
        */

        if (dayOfWeek === 0) {

            addDatabaseEvent(
                dateKey,
                "tacticsEndgameSunday"
            );

        }

    }

}function addDatabaseEvent(dateKey, eventType) {

    const pattern =
        eventPatterns[eventType];


    /*
        Copy the recurring pattern into
        this specific date.
    */

    const event = {

        type: eventType,

        title: pattern.title,

        time: pattern.time,

        link: pattern.link

    };


    /*
        Check whether this specific date
        has an override.
    */

    if (
        databaseDirectory[dateKey] &&
        databaseDirectory[dateKey][eventType]
    ) {

        const override =
            databaseDirectory[dateKey][eventType];


        if (override.title !== undefined) {
            event.title = override.title;
        }

        if (override.time !== undefined) {
            event.time = override.time;
        }

        if (override.link !== undefined) {
            event.link = override.link;
        }

    }


    eventDatabase[dateKey].push(event);

}


/*
    ========================================
    SPECIAL EVENTS
    ========================================

    Put one-off events here.

    These are added AFTER the regular
    schedule, so a date can contain both
    regular and special events.

*/

const specialEvents = {

    /*
    Example:

    "2026-10-31": [
        {
            title: "🎃 Republic Halloween Event",
            time: "7:00 PM CST",
            link: "https://example.com"
        }
    ]

    */

};


/*
    Add special events to database
*/

Object.keys(specialEvents).forEach(function(date) {

    specialEvents[date].forEach(function(event) {

        addEvent(date, event);

    });

});


/*
    Generate the regular schedule.
*/

/*
    Generate the regular schedule first.
*/

generateRepublicSchedule();


/*
    Then add special events.
*/

Object.keys(specialEvents).forEach(function(date) {

    specialEvents[date].forEach(function(event) {

        addEvent(date, event);

    });

});


/*
    ========================================
    BUILD CALENDAR
    ========================================
*/

function buildCalendar() {

    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);

    const firstWeekday = firstDay.getDay();
    const daysInMonth = lastDay.getDate();

    const monthName = document.getElementById("monthName");
    const days = document.getElementById("days");

    monthName.textContent =
        firstDay.toLocaleString("en-US", {
            month: "long",
            year: "numeric"
        });

    days.innerHTML = "";

    /*
        Empty spaces before the first day
    */

    for (let i = 0; i < firstWeekday; i++) {

        const empty = document.createElement("div");

        empty.className = "day empty";

        days.appendChild(empty);

    }


    /*
        Generate every day
    */

    for (let dayNumber = 1; dayNumber <= daysInMonth; dayNumber++) {

        const date = new Date(year, month, dayNumber);

        const cell = document.createElement("div");

        cell.className = "day";


        /*
            Highlight today
        */

        const today = new Date();

        if (
            date.getFullYear() === today.getFullYear() &&
            date.getMonth() === today.getMonth() &&
            date.getDate() === today.getDate()
        ) {

            cell.classList.add("today");

        }


        /*
            Date number
        */

        const number = document.createElement("div");

        number.className = "day-number";

        number.textContent = dayNumber;

        cell.appendChild(number);


        const dateKey =
    getDateKey(
        year,
        month + 1,
        dayNumber
    );

const events =
    eventDatabase[dateKey] || [];

        events.slice(0, 2).forEach(function(event) {

            const dot =
                document.createElement("span");

            dot.className = "event-dot";

            dot.textContent = event.title;

            cell.appendChild(dot);

        });


        if (events.length > 2) {

            const more =
                document.createElement("span");

            more.className = "event-dot";

            more.textContent =
                "+" + (events.length - 2) + " more";

            cell.appendChild(more);

        }


        /*
            Click date
        */

        cell.onclick = function() {

            showEvents(
                date,
                events
            );

        };


        days.appendChild(cell);

    }

}


/*
    ========================================
    SHOW EVENTS
    ========================================
*/

function showEvents(date, events) {

    const panel =
        document.getElementById("eventPanel");

    panel.innerHTML = "";


    const heading =
        document.createElement("div");

    heading.className = "event-date";

    heading.textContent =
        date.toLocaleString("en-US", {
            weekday: "long",
            month: "long",
            day: "numeric",
            year: "numeric"
        });

    panel.appendChild(heading);


    if (events.length === 0) {

        const none =
            document.createElement("div");

        none.className = "no-events";

        none.textContent =
            "No scheduled Republic events.";

        panel.appendChild(none);

    }
    else {

        events.forEach(function(event) {

            const eventBox =
                document.createElement("div");

            eventBox.className = "event";


const title =
    document.createElement(
        event.link ? "a" : "div"
    );

title.className = "event-title";

title.textContent =
    event.title;


if (event.link) {

    title.href = event.link;

    title.target = "_blank";

    title.style.color = "white";

    title.style.textDecoration = "none";

}


const time =
    document.createElement("div");

time.className = "event-time";

time.textContent =
    event.time;


eventBox.appendChild(title);

eventBox.appendChild(time);

            panel.appendChild(eventBox);

        });

    }


    panel.classList.add("active");

}


/*
    ========================================
    CHANGE MONTH
    ========================================
*/

function changeMonth(amount) {

    currentDate.setMonth(
        currentDate.getMonth() + amount
    );

    buildCalendar();

    document
        .getElementById("eventPanel")
        .classList.remove("active");

}


/*
    ========================================
    DATE KEY
    ========================================
*/

function getDateKey(year, month, day) {

    return (
        year + "-" +
        String(month).padStart(2, "0") + "-" +
        String(day).padStart(2, "0")
    );

}


/*
    ========================================
    START
    ========================================
*/

buildCalendar();

</script>

</body>
</html>
